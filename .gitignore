# Whitelist: only code, notebooks and the paper are versioned.
/*
!/README.md
!/.gitignore
!/LICENSE
!/LICENSE-CC-BY-4.0.md
!/examples/
!/paper/

/examples/*
!/examples/*.ipynb
!/examples/*.py
!/examples/README.md
!/examples/requirements.txt
!/examples/data/
/examples/data/*
!/examples/data/PLANETCARE.md
!/examples/data/planetcare_tickets.json
!/examples/data/planetcare_kb.json
!/examples/data/planetcare_wiki/

/paper/*
!/paper/graphs-for-llm-agents-evaluation.tex
!/paper/graphs-for-llm-agents-evaluation.pdf
!/paper/references.bib

.DS_Store
__pycache__/
